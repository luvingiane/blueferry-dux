{
    "id": "iphoneStatus",
    "name": "iPhone Status",
    "description": "Battery, signal, carrier, notifications, now playing and recent calls of the iPhone, read from BlueFerry",
    "version": "1.1.0",
    "author": "Matt",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "control-center", "iphone", "bluetooth"],
    "icon": "phone_iphone",
    "components": {
        "daemon": "./PhoneDaemon.qml",
        "widget": "./PhoneWidget.qml"
    },
    "settings": "./PhoneSettings.qml",
    "requires_dms": ">=1.7.0",
    "requires": ["gdbus", "blueferry"],
    "permissions": ["settings_read", "settings_write", "process", "network"]
}
